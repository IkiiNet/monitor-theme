{
  "name": "NezhaDash",
  "short": "nezha-dash",
  "description": "nezha-dash V2 移植版",
  "version": "1.8.3",
  "author": "hamster1963 (ported to monitor)",
  "url": "https://github.com/IkiiNet/monitor-theme",
  "config": [
    { "type": "title", "label": "站点外观" },
    { "key": "site_title", "type": "string", "label": "网站标题", "default": "", "help": "左上角标题；留空用站点名" },
    { "key": "site_subtitle", "type": "string", "label": "副标题", "default": "", "help": "标题右侧小字；留空不显示" },
    { "key": "logo_url", "type": "string", "label": "标题前图标", "default": "", "help": "图标地址（URL 或 / 开头路径）；留空不显示" },
    { "key": "favicon_url", "type": "string", "label": "站点图标", "default": "", "help": "浏览器标签图标；留空不显示" },
    {
      "key": "default_theme",
      "type": "select",
      "label": "默认外观",
      "default": "system",
      "help": "访客首次进入的外观",
      "options": [
        { "value": "system", "label": "跟随系统" },
        { "value": "light", "label": "浅色" },
        { "value": "dark", "label": "深色" }
      ]
    },
    { "key": "background_image", "type": "string", "label": "桌面端背景", "default": "", "help": "整页背景图地址；留空无背景" },
    { "key": "mobile_background_image", "type": "string", "label": "移动端背景", "default": "", "help": "窄屏下的背景图地址；留空无背景" },

    { "type": "title", "label": "首页与列表" },
    { "key": "notice", "type": "text", "label": "公告", "default": "", "help": "页面顶部公告；留空不显示" },
    { "key": "card_equal_height", "type": "boolean", "label": "卡片等高", "default": true, "help": "所有服务器卡片保持相同高度" },
    { "key": "force_card_inline", "type": "boolean", "label": "默认紧凑列表", "default": false, "help": "访客首次进入用紧凑列表；仍可切换" },
    {
      "key": "force_sort_type",
      "type": "select",
      "label": "默认排序字段",
      "default": "",
      "help": "覆盖访客的首选排序字段",
      "options": [
        { "value": "", "label": "不强制" },
        { "value": "name", "label": "名称" },
        { "value": "uptime", "label": "运行时间" },
        { "value": "system", "label": "系统" },
        { "value": "cpu", "label": "CPU" },
        { "value": "mem", "label": "内存" },
        { "value": "disk", "label": "硬盘" },
        { "value": "up", "label": "上行速率" },
        { "value": "down", "label": "下行速率" },
        { "value": "up total", "label": "上行流量" },
        { "value": "down total", "label": "下行流量" }
      ]
    },
    {
      "key": "force_sort_order",
      "type": "select",
      "label": "默认排序方向",
      "default": "",
      "help": "覆盖访客的首选排序方向",
      "options": [
        { "value": "", "label": "不强制" },
        { "value": "desc", "label": "降序" },
        { "value": "asc", "label": "升序" }
      ]
    },

    { "type": "title", "label": "图表与其它" },
    { "key": "force_peak_cut", "type": "boolean", "label": "剔除带宽峰值", "default": true, "help": "图表忽略带宽尖峰；关闭则按真实峰值缩放" },
    { "key": "custom_links", "type": "text", "label": "自定义导航链接", "default": "", "help": "JSON 数组，显示在页头右上角。例：[{\"name\":\"Blog\",\"link\":\"https://example.com\"}]" },
    {
      "key": "default_language",
      "type": "select",
      "label": "默认语言",
      "default": "zh-CN",
      "help": "访客首次进入的语言",
      "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "en-US", "label": "English" }
      ]
    }
  ]
}
